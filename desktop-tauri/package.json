{
  "name": "vibechat-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "predev": "npm run prepare:frontend",
    "dev": "tauri dev",
    "prebuild": "npm run prepare:frontend",
    "build": "tauri build",
    "test": "node --test scripts/prepare-frontend.test.mjs",
    "precheck": "npm run prepare:frontend",
    "check": "npm test && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo test --manifest-path src-tauri/Cargo.toml && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
